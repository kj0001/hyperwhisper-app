<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperWhisper\HyperWhisper.csproj" />
    <ProjectReference Include="..\..\shared-dotnet\HyperWhisper.Application\HyperWhisper.Application.csproj" />
    <!-- The vectors are the cross-platform contract, not a fixture of this
         project: the Linux backup harness runs the same file. -->
    <Content Include="../../../shared-conformance/backup-vectors.json"
             Link="backup-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same arrangement for the (provider -> default model) vectors: Rust, the
         portable head and macOS replay this very file. -->
    <Content Include="../../../shared-conformance/default-model-vectors.json"
             Link="default-model-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- And for the provider health verdict (issue #779): Rust, the portable
         head and macOS replay this very file. -->
    <Content Include="../../../shared-conformance/health-vectors.json"
             Link="health-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Whisper's non-speech marker vectors (issue #1811): Rust, the Linux
         local-inference harness and macOS replay this very file. -->
    <Content Include="../../../shared-conformance/whisper-marker-vectors.json"
             Link="whisper-marker-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
